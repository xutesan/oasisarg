generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// kind, theme and copy also have check constraints, see migrations/0_init.
// prisma can't express those, so keep them when you change these columns
model Entry {
  id      String   @id
  kind    String
  title   String   @default("")
  body    String   @default("")
  link    String?
  // has to match a theme id in components/terminal/themes.ts
  theme   String?
  // overrides the theme's wording, e.g. {"title": "...", "boot": ["...", ""]}
  copy    Json?
  phrases Phrase[]
  logins  Login[]

  @@map("entries")
}

// case, spacing, punctuation and accents are ignored when matching, type phrases however
model Phrase {
  phrase  String @id
  entryId String @map("entry_id")
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("phrases")
}

// usernames are stored lowercase (a check in migrations/2_lowercase_usernames), passwords keep their case.
// plain text on purpose, they're part of the story
model Login {
  username String @id
  password String
  entryId  String @map("entry_id")
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("logins")
}
